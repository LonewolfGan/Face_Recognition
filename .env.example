# ============================================================================
# REQUIRED SECURITY CONFIGURATION
# ============================================================================
# These must be set to strong, unique values in production
SECRET_KEY=generate-strong-secret-key-here-minimum-32-characters
JWT_SECRET_KEY=generate-strong-jwt-secret-key-here-minimum-32-characters

# Frontend origin(s) for CORS - REQUIRED in production
# Example for single origin:
CORS_ORIGINS=https://your-app.vercel.app
# Example for multiple origins (comma-separated):
# CORS_ORIGINS=https://your-app.vercel.app,https://admin.your-app.com

# ============================================================================
# OPTIONAL SECURITY SETTINGS
# ============================================================================
# Token expiration times (in seconds)
JWT_ACCESS_TOKEN_EXPIRES=900  # 15 minutes
JWT_REFRESH_TOKEN_EXPIRES=604800  # 7 days

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Use PostgreSQL in production (recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/face_recognition

# For SQLite (development only):
# DATABASE_PATH=data/users.db

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
FLASK_ENV=development  # development|testing|production
MODEL_NAME=SFace
DETECTOR_BACKEND=opencv
DATA_DIR=backend/data/

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
# Enable debug mode (development only - never use in production)
FLASK_DEBUG=true

# Frontend development URL
VITE_API_URL=http://localhost:5000
